# ==============================================================================
# HOF Migration — Environment Variables
# ==============================================================================

# 1. Supabase / PostgreSQL Direct Connection String
# Get this from Supabase Dashboard: Project Settings -> Database -> Connection String -> URI
DATABASE_URI=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# 2. Payload CMS Secret (any long random secure string)
PAYLOAD_SECRET=hof-migration-payload-secret-key-prod-2026-secure

# 3. Next.js App Public URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
